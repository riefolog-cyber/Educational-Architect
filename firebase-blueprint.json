{
  "entities": {
    "valutazione": {
      "title": "Valutazione",
      "description": "I risultati delle valutazioni degli studenti.",
      "type": "object",
      "properties": {
        "Timestamp": { "type": "string" },
        "Docente_Email": { "type": "string" },
        "Tipo": { "type": "string" },
        "Pin": { "type": "string" },
        "Session_Id": { "type": "string" },
        "Session_Titolo": { "type": "string" },
        "Nome": { "type": "string" },
        "Email": { "type": "string" },
        "Classe": { "type": "string" },
        "Voto_Suggerito": { "type": "string" },
        "Voto_Originale_IA": { "type": "string" },
        "Autovalutazione": { "type": "string" },
        "AntiCopia_TabSwitch": { "type": "integer" },
        "AntiCopia_IncollaBloccato": { "type": "integer" },
        "AntiCopia_SchermoDiviso": { "type": "integer" },
        "AntiCopia_InfractionsLog": { "type": "string" },
        "Full_Evaluation": { "type": "string" },
        "Risposte_Studente": { "type": "string" },
        "Domande_Esame": { "type": "string" },
        "Piano_Recupero": { "type": "string" },
        "Pseudo_Id": { "type": "string" },
        "PII_Oscurate_Count": { "type": "integer" },
        "Convalida_Docente_At": { "type": "string" },
        "Convalida_Docente_Email": { "type": "string" },
        "Soluzioni_Differite": { "type": "boolean" },
        "Assigned_Fila": { "type": "string", "enum": ["A", "B"] },
        "MC_Order": { "type": "string" },
        "Oral_Answers_Count": { "type": "integer" }
      },
      "required": ["Timestamp", "Tipo", "Email", "Classe", "Voto_Suggerito"]
    },
    "docente": {
      "title": "Docente",
      "description": "Le configurazioni dei docenti autorizzati.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "gasUrl": { "type": "string" },
        "role": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "active_session": {
      "title": "Sessione Attiva",
      "description": "Le sessioni d'esame attivate dai docenti.",
      "type": "object",
      "properties": {
        "pin": { "type": "string" },
        "title": { "type": "string" },
        "targetClass": { "type": "string", "maxLength": 40 },
        "allowedClasses": { "type": "array" },
        "restrictToAllowedClasses": { "type": "boolean" },
        "expiry": { "type": "string" },
        "maxExtendedExpiry": { "type": "string" },
        "teacherEmail": { "type": "string" },
        "teacherId": { "type": "string" },
        "sessionId": { "type": "string" },
        "active": { "type": "boolean" },
        "randomizeQuestions": { "type": "boolean" },
        "deferSolutions": { "type": "boolean" },
        "solutionsReleased": { "type": "boolean" },
        "releasedClasses": { "type": "array" },
        "autoReleaseSolutions": { "type": "boolean" },
        "solutionsReleasedAt": { "type": "string" },
        "besOptions": { "type": "object" },
        "mixFilaAB": { "type": "boolean" },
        "filaBTitle": { "type": "string" },
        "allowAudioAnswers": { "type": "boolean" },
        "classNotice": { "type": "string" },
        "classNoticeAt": { "type": "string" },
        "classNoticeTargetClass": { "type": "string" },
        "archived": { "type": "boolean" },
        "archivedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "unlockCode": { "type": "string" },
        "data": { "type": "string" },
        "filaBData": { "type": "string" }
      },
      "required": ["pin", "expiry"]
    },
    "live_student": {
      "title": "Stato Live Studente",
      "description": "Telemetria di avanzamento, blocchi anti-copia e bozza cloud di uno studente in sessione.",
      "type": "object",
      "properties": {
        "studentName": { "type": "string" },
        "studentEmail": { "type": "string" },
        "studentClass": { "type": "string" },
        "answeredCount": { "type": "integer" },
        "totalQuestions": { "type": "integer" },
        "currentProgressPercent": { "type": "integer" },
        "tabSwitches": { "type": "integer" },
        "pasteAttempts": { "type": "integer" },
        "lastHeartbeat": { "type": "string" },
        "joinedAt": { "type": "string" },
        "sessionRunId": { "type": "string" },
        "status": { "type": "string" },
        "locked": { "type": "boolean" },
        "lockState": { "type": "string" },
        "lockReason": { "type": "string" },
        "lockedAt": { "type": "string" },
        "draftAnswersJson": { "type": "string" },
        "draftUpdatedAt": { "type": "string" },
        "besExpiryIso": { "type": "string" },
        "extendedExpiryIso": { "type": "string" },
        "assignedFila": { "type": "string", "enum": ["A", "B"] },
        "remoteUnlockId": { "type": "string" },
        "unlockedAt": { "type": "string" },
        "unlockedBy": { "type": "string" },
        "teacherNotice": { "type": "string" },
        "teacherNoticeAt": { "type": "string" },
        "teacherNoticeAckAt": { "type": "string" },
        "classNoticeAckAt": { "type": "string" }
      },
      "required": ["studentEmail"]
    },
    "exam_library_item": {
      "title": "Verifica Salvata in Libreria",
      "description": "Le verifiche salvate e riutilizzabili dai docenti.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teacherEmail": { "type": "string" },
        "title": { "type": "string" },
        "examType": { "type": "string" },
        "examJson": { "type": "string" },
        "source": { "type": "string" },
        "questionCount": { "type": "integer" },
        "sharedCode": { "type": "string", "maxLength": 16 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "examJson"]
    },
    "shared_exam": {
      "title": "Verifica Condivisa tra Docenti",
      "description": "Template verifica esportato con codice breve per importazione da parte di colleghi.",
      "type": "object",
      "properties": {
        "shareCode": { "type": "string" },
        "teacherEmail": { "type": "string" },
        "title": { "type": "string" },
        "examType": { "type": "string" },
        "examJson": { "type": "string" },
        "questionCount": { "type": "integer" },
        "createdAt": { "type": "string" }
      },
      "required": ["shareCode", "teacherEmail", "title", "examType", "examJson"]
    }
  },
  "firestore": {
    "valutazioni/{valId}": {
      "schema": "valutazione",
      "description": "Collezione dei risultati dei test degli studenti."
    },
    "docenti/{docId}": {
      "schema": "docente",
      "description": "Collezione delle configurazioni dei docenti."
    },
    "active_sessions/{sessionId}": {
      "schema": "active_session",
      "description": "Collezione delle sessioni attive d'esame."
    },
    "active_sessions/{sessionId}/live_students/{studentId}": {
      "schema": "live_student",
      "description": "Sottocollezione dello stato live e delle bozze salvate per ciascun alunno."
    },
    "exam_library/{docId}": {
      "schema": "exam_library_item",
      "description": "Collezione delle prove salvate in libreria riutilizzabili."
    },
    "shared_exams/{shareCode}": {
      "schema": "shared_exam",
      "description": "Collezione delle verifiche condivise con codice breve tra docenti."
    }
  }
}
