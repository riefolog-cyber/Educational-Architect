# Environment variables required by the application
GEMINI_API_KEY=
APP_URL=

# Facoltativo: chiave API Google Cloud con "Google Forms API" abilitata.
# Se presente, l'import via link pre-segna anche le RISPOSTE CORRETTE del
# modulo Quiz (form.googleapis.com). Senza chiave l'import resta funzionante
# con il segno manuale o con l'Apps Script "Web App" (google-forms-export.gs).
FORMS_API_KEY=
