# Environment variables required by the application
GEMINI_API_KEY=
APP_URL=

# Facoltativo: import dei moduli via OAuth (endpoint attivi, pulsante NON esposto
# nell'interfaccia: vedi l'appendice della guida).
# Crea un ID client OAuth di tipo "Applicazione web" in Google Cloud, abilita la
# Google Forms API sullo stesso progetto e autorizza il redirect
#   <APP_URL>/api/google/oauth/callback
# APP_URL (sopra) è la base pubblica dell'app, senza slash finale: serve al redirect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facoltative: capienza delle due code di correzione.
# EVAL_CONCURRENCY = elaborati corretti in parallelo (default 8, max 12).
# EVAL_MAX_QUEUE  = quanti elaborati possono attendere in coda (default 200).
# RECOVERY_CONCURRENCY / RECOVERY_MAX_QUEUE = corsia separata dei piani di
# recupero (default 2 e 80): così non rubano posti alle correzioni.
EVAL_CONCURRENCY=
EVAL_MAX_QUEUE=
RECOVERY_CONCURRENCY=
RECOVERY_MAX_QUEUE=

# Legacy: la Forms API ufficiale richiede OAuth, quindi con una semplice chiave
# API l'arricchimento delle risposte corrette di solito non parte (resta
# silenzioso e l'import funziona lo stesso). Per le corrette usa lo script
# google-forms-export.gs oppure, se proprio serve l'accesso diretto, l'appendice
# OAuth della guida (lato server, non esposto nell'interfaccia).
FORMS_API_KEY=
