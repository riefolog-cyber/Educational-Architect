rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Global Helpers ---
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDocId(id) {
      return id is string && id.size() > 0 && id.size() <= 200 && id.matches('^[a-zA-Z0-9_.\\-@]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Authentication & Role Helpers ---
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isPrimaryTeacher() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'riefolog@gmail.com' ||
        request.auth.token.email.lower() == 'riefolo.giovanni@ferrarisfermiclass.it'
      );
    }

    function isTeacher() {
      return isPrimaryTeacher() || (
        isSignedIn() && (
          exists(/databases/$(database)/documents/docenti/$(request.auth.token.email)) ||
          exists(/databases/$(database)/documents/docenti/$(request.auth.token.email.lower())) ||
          exists(/databases/$(database)/documents/docenti/$(request.auth.uid))
        )
      );
    }

    // --- Validation Helpers ---
    function isValidDocente(data) {
      return data is map &&
        data.keys().hasAll(['email', 'role']) &&
        data.keys().hasOnly(['email', 'role', 'gasUrl']) &&
        data.email is string && data.email.size() > 3 && data.email.size() <= 200 &&
        data.role in ['admin', 'teacher'] &&
        (!('gasUrl' in data) || (data.gasUrl is string && data.gasUrl.size() <= 500));
    }

    function isValidExamLibraryItem(data) {
      return data is map &&
        data.keys().hasAll(['id', 'title', 'examJson']) &&
        data.keys().hasOnly(['id', 'teacherEmail', 'title', 'examType', 'examJson', 'source', 'questionCount', 'sharedCode', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 120 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        data.examJson is string && data.examJson.size() > 2 && data.examJson.size() <= 900000 &&
        (!('teacherEmail' in data) || (data.teacherEmail is string && data.teacherEmail.size() <= 200)) &&
        (!('examType' in data) || data.examType in ['Quiz', 'Workbook']) &&
        (!('source' in data) || (data.source is string && data.source.size() <= 120)) &&
        (!('questionCount' in data) || data.questionCount is int) &&
        (!('sharedCode' in data) || (data.sharedCode is string && data.sharedCode.size() <= 16)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidSharedExam(data) {
      return data is map &&
        data.keys().hasAll(['shareCode', 'teacherEmail', 'title', 'examType', 'examJson']) &&
        data.keys().hasOnly(['shareCode', 'teacherEmail', 'title', 'examType', 'examJson', 'questionCount', 'createdAt']) &&
        data.shareCode is string && data.shareCode.size() >= 6 && data.shareCode.size() <= 16 &&
        data.teacherEmail is string && data.teacherEmail.size() > 0 && data.teacherEmail.size() <= 200 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        data.examType in ['Quiz', 'Workbook'] &&
        data.examJson is string && data.examJson.size() > 2 && data.examJson.size() <= 900000 &&
        (!('questionCount' in data) || data.questionCount is int) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidClassItem(val) {
      return val is string && val.size() > 0 && val.size() <= 40;
    }

    function isValidClassArray(arr) {
      return arr is list &&
        arr.size() <= 30 &&
        (arr.size() < 1 || isValidClassItem(arr[0])) &&
        (arr.size() < 2 || isValidClassItem(arr[1])) &&
        (arr.size() < 3 || isValidClassItem(arr[2])) &&
        (arr.size() < 4 || isValidClassItem(arr[3])) &&
        (arr.size() < 5 || isValidClassItem(arr[4])) &&
        (arr.size() < 6 || isValidClassItem(arr[5])) &&
        (arr.size() < 7 || isValidClassItem(arr[6])) &&
        (arr.size() < 8 || isValidClassItem(arr[7])) &&
        (arr.size() < 9 || isValidClassItem(arr[8])) &&
        (arr.size() < 10 || isValidClassItem(arr[9])) &&
        (arr.size() < 11 || isValidClassItem(arr[10])) &&
        (arr.size() < 12 || isValidClassItem(arr[11])) &&
        (arr.size() < 13 || isValidClassItem(arr[12])) &&
        (arr.size() < 14 || isValidClassItem(arr[13])) &&
        (arr.size() < 15 || isValidClassItem(arr[14])) &&
        (arr.size() < 16 || isValidClassItem(arr[15])) &&
        (arr.size() < 17 || isValidClassItem(arr[16])) &&
        (arr.size() < 18 || isValidClassItem(arr[17])) &&
        (arr.size() < 19 || isValidClassItem(arr[18])) &&
        (arr.size() < 20 || isValidClassItem(arr[19])) &&
        (arr.size() < 21 || isValidClassItem(arr[20])) &&
        (arr.size() < 22 || isValidClassItem(arr[21])) &&
        (arr.size() < 23 || isValidClassItem(arr[22])) &&
        (arr.size() < 24 || isValidClassItem(arr[23])) &&
        (arr.size() < 25 || isValidClassItem(arr[24])) &&
        (arr.size() < 26 || isValidClassItem(arr[25])) &&
        (arr.size() < 27 || isValidClassItem(arr[26])) &&
        (arr.size() < 28 || isValidClassItem(arr[27])) &&
        (arr.size() < 29 || isValidClassItem(arr[28])) &&
        (arr.size() < 30 || isValidClassItem(arr[29]));
    }

    function isValidActiveSession(data) {
      return data is map &&
        data.keys().hasAll(['pin', 'expiry', 'teacherEmail', 'active']) &&
        data.keys().hasOnly([
          'pin', 'title', 'targetClass', 'allowedClasses', 'restrictToAllowedClasses',
          'expiry', 'maxExtendedExpiry', 'teacherEmail', 'teacherId', 'data',
          'encryptedAnswerKey', 'randomizeQuestions', 'deferSolutions',
          'solutionsReleased', 'releasedClasses', 'autoReleaseSolutions', 'solutionsReleasedAt', 'besOptions',
          'mixFilaAB', 'filaBData', 'encryptedFilaBAnswerKey', 'filaBTitle',
          'allowAudioAnswers', 'severityPreset', 'unlockCode', 'active',
          'classNotice', 'classNoticeAt', 'classNoticeTargetClass',
          'archived', 'archivedAt',
          'createdAt', 'sessionId', 'backendUrl'
        ]) &&
        data.pin is string && data.pin.size() > 0 && data.pin.size() <= 40 &&
        data.expiry is string && data.expiry.size() > 0 && data.expiry.size() <= 64 &&
        (!('maxExtendedExpiry' in data) || (data.maxExtendedExpiry is string && data.maxExtendedExpiry.size() <= 64)) &&
        data.teacherEmail is string && data.teacherEmail.size() > 0 && data.teacherEmail.size() <= 200 &&
        data.active is bool &&
        (!('archived' in data) || data.archived is bool) &&
        (!('archivedAt' in data) || (data.archivedAt is string && data.archivedAt.size() <= 64)) &&
        (!('title' in data) || (data.title is string && data.title.size() <= 300)) &&
        (!('targetClass' in data) || (data.targetClass is string && data.targetClass.size() <= 40)) &&
        (!('allowedClasses' in data) || isValidClassArray(data.allowedClasses)) &&
        (!('releasedClasses' in data) || isValidClassArray(data.releasedClasses)) &&
        (!('restrictToAllowedClasses' in data) || data.restrictToAllowedClasses is bool) &&
        (!('autoReleaseSolutions' in data) || data.autoReleaseSolutions is bool) &&
        (!('classNotice' in data) || (data.classNotice is string && data.classNotice.size() <= 300)) &&
        (!('classNoticeAt' in data) || (data.classNoticeAt is string && data.classNoticeAt.size() <= 64)) &&
        (!('classNoticeTargetClass' in data) || (data.classNoticeTargetClass is string && data.classNoticeTargetClass.size() <= 40)) &&
        (!('teacherId' in data) || (data.teacherId is string && data.teacherId.size() <= 128)) &&
        (!('sessionId' in data) || (data.sessionId is string && data.sessionId.size() <= 128)) &&
        (!('backendUrl' in data) || (data.backendUrl is string && data.backendUrl.size() <= 200)) &&
        (!('severityPreset' in data) || (data.severityPreset is string && data.severityPreset.size() <= 40)) &&
        (!('encryptedAnswerKey' in data) || (data.encryptedAnswerKey is string && data.encryptedAnswerKey.size() <= 300000)) &&
        (!('encryptedFilaBAnswerKey' in data) || (data.encryptedFilaBAnswerKey is string && data.encryptedFilaBAnswerKey.size() <= 300000)) &&
        (!('filaBTitle' in data) || (data.filaBTitle is string && data.filaBTitle.size() <= 300)) &&
        (!('randomizeQuestions' in data) || data.randomizeQuestions is bool) &&
        (!('deferSolutions' in data) || data.deferSolutions is bool) &&
        (!('solutionsReleased' in data) || data.solutionsReleased is bool) &&
        (!('mixFilaAB' in data) || data.mixFilaAB is bool) &&
        (!('allowAudioAnswers' in data) || data.allowAudioAnswers is bool) &&
        (!('besOptions' in data) || data.besOptions is map) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('unlockCode' in data) || (data.unlockCode is string && data.unlockCode.size() <= 64)) &&
        (!('data' in data) || data.data is map || (data.data is string && data.data.size() <= 650000)) &&
        (!('filaBData' in data) || data.filaBData is map || (data.filaBData is string && data.filaBData.size() <= 650000)) &&
        (!('solutionsReleasedAt' in data) || (data.solutionsReleasedAt is string && data.solutionsReleasedAt.size() <= 64));
    }

    function isValidSubmissionPayload(data) {
      return data is map &&
        data.keys().hasAll(['Timestamp', 'Tipo', 'Email', 'Voto_Suggerito']) &&
        data.keys().hasOnly([
          'Timestamp', 'Docente_Email', 'Tipo', 'Pin', 'Session_Id', 'Session_Titolo',
          'Nome', 'Email', 'Classe', 'Pseudo_Id', 'PII_Oscurate_Count',
          'Voto_Suggerito', 'Voto_Originale_IA', 'Autovalutazione',
          'Punteggio_MC', 'Punteggio_FIB',
          'AntiCopia_TabSwitch', 'AntiCopia_IncollaBloccato', 'AntiCopia_SchermoDiviso', 'AntiCopia_InfractionsLog',
          'Errori_Principali', 'Feedback_Generale', 'Full_Evaluation',
          'Risposte_Studente', 'Domande_Esame', 'Piano_Recupero',
          'Convalida_Docente_At', 'Convalida_Docente_Email', 'Soluzioni_Differite',
          'Assigned_Fila', 'MC_Order', 'Oral_Answers_Count'
        ]) &&
        data.Timestamp is string && data.Timestamp.size() > 0 && data.Timestamp.size() <= 64 &&
        data.Tipo in ['Quiz', 'Workbook'] &&
        data.Email is string && data.Email.size() > 0 && data.Email.size() <= 200 &&
        data.Voto_Suggerito is string && data.Voto_Suggerito.size() <= 40 &&
        (!('Docente_Email' in data) || (data.Docente_Email is string && data.Docente_Email.size() <= 200)) &&
        (!('Pin' in data) || (data.Pin is string && data.Pin.size() <= 40)) &&
        (!('Session_Id' in data) || (data.Session_Id is string && data.Session_Id.size() <= 128)) &&
        (!('Session_Titolo' in data) || (data.Session_Titolo is string && data.Session_Titolo.size() <= 300)) &&
        (!('Nome' in data) || (data.Nome is string && data.Nome.size() <= 200)) &&
        (!('Classe' in data) || (data.Classe is string && data.Classe.size() <= 40)) &&
        (!('Pseudo_Id' in data) || (data.Pseudo_Id is string && data.Pseudo_Id.size() <= 64)) &&
        (!('PII_Oscurate_Count' in data) || (data.PII_Oscurate_Count is int && data.PII_Oscurate_Count >= 0 && data.PII_Oscurate_Count <= 10000)) &&
        (!('Voto_Originale_IA' in data) || (data.Voto_Originale_IA is string && data.Voto_Originale_IA.size() <= 40)) &&
        (!('Autovalutazione' in data) || (data.Autovalutazione is string && data.Autovalutazione.size() <= 2000)) &&
        (!('Punteggio_MC' in data) || (data.Punteggio_MC is number && data.Punteggio_MC >= 0 && data.Punteggio_MC <= 1000)) &&
        (!('Punteggio_FIB' in data) || (data.Punteggio_FIB is number && data.Punteggio_FIB >= 0 && data.Punteggio_FIB <= 1000)) &&
        (!('AntiCopia_TabSwitch' in data) || (data.AntiCopia_TabSwitch is int && data.AntiCopia_TabSwitch >= 0 && data.AntiCopia_TabSwitch <= 10000)) &&
        (!('AntiCopia_IncollaBloccato' in data) || (data.AntiCopia_IncollaBloccato is int && data.AntiCopia_IncollaBloccato >= 0 && data.AntiCopia_IncollaBloccato <= 10000)) &&
        (!('AntiCopia_SchermoDiviso' in data) || (data.AntiCopia_SchermoDiviso is int && data.AntiCopia_SchermoDiviso >= 0 && data.AntiCopia_SchermoDiviso <= 10000)) &&
        (!('AntiCopia_InfractionsLog' in data) || (data.AntiCopia_InfractionsLog is string && data.AntiCopia_InfractionsLog.size() <= 100000)) &&
        (!('Errori_Principali' in data) || (data.Errori_Principali is string && data.Errori_Principali.size() <= 100000)) &&
        (!('Feedback_Generale' in data) || (data.Feedback_Generale is string && data.Feedback_Generale.size() <= 100000)) &&
        (!('Full_Evaluation' in data) || (data.Full_Evaluation is string && data.Full_Evaluation.size() <= 300000)) &&
        (!('Risposte_Studente' in data) || (data.Risposte_Studente is string && data.Risposte_Studente.size() <= 250000)) &&
        (!('Domande_Esame' in data) || (data.Domande_Esame is string && data.Domande_Esame.size() <= 600000)) &&
        (!('Piano_Recupero' in data) || (data.Piano_Recupero is string && data.Piano_Recupero.size() <= 40000)) &&
        (!('Convalida_Docente_At' in data) || (data.Convalida_Docente_At is string && data.Convalida_Docente_At.size() <= 64)) &&
        (!('Convalida_Docente_Email' in data) || (data.Convalida_Docente_Email is string && data.Convalida_Docente_Email.size() <= 200)) &&
        (!('Soluzioni_Differite' in data) || data.Soluzioni_Differite is bool) &&
        (!('Assigned_Fila' in data) || data.Assigned_Fila in ['A', 'B']) &&
        (!('MC_Order' in data) || (data.MC_Order is string && data.MC_Order.size() <= 40000)) &&
        (!('Oral_Answers_Count' in data) || (data.Oral_Answers_Count is int && data.Oral_Answers_Count >= 0 && data.Oral_Answers_Count <= 100));
    }

    function isValidSubmissionCreate(data) {
      return isValidSubmissionPayload(data) &&
        'Classe' in data && data.Classe is string && data.Classe.size() >= 2 && data.Classe.size() <= 40 &&
        !('Convalida_Docente_At' in data) &&
        !('Convalida_Docente_Email' in data) &&
        !('Voto_Originale_IA' in data);
    }

    function isStudentRecoveryPlanUpdate() {
      return incoming().diff(existing()).affectedKeys().hasOnly(['Piano_Recupero']) &&
        incoming().Piano_Recupero is string &&
        incoming().Piano_Recupero.size() <= 40000 &&
        (!isSignedIn() || existing().Email.lower() == request.auth.token.email.lower());
    }

    function isValidLiveStudentWrite(data) {
      return data is map &&
        data.keys().hasOnly([
          'studentName', 'studentEmail', 'studentClass', 'answeredCount', 'totalQuestions',
          'mcDoneCount', 'openDoneCount', 'currentProgressPercent',
          'tabSwitches', 'pasteAttempts', 'lastHeartbeat', 'status',
          'joinedAt', 'sessionRunId', 'locked', 'lockState', 'lockReason',
          'lockedAt', 'draftAnswersJson', 'draftUpdatedAt',
          'besExpiryIso', 'extendedExpiryIso', 'assignedFila',
          'remoteUnlockId', 'unlockedAt', 'unlockedBy',
          'teacherNotice', 'teacherNoticeAt', 'teacherNoticeAckAt', 'classNoticeAckAt'
        ]) &&
        (!('studentName' in data) || (data.studentName is string && data.studentName.size() <= 200)) &&
        (!('studentEmail' in data) || (data.studentEmail is string && data.studentEmail.size() <= 200)) &&
        (!('studentClass' in data) || (data.studentClass is string && data.studentClass.size() <= 40)) &&
        (!('draftAnswersJson' in data) || (data.draftAnswersJson is string && data.draftAnswersJson.size() <= 220000)) &&
        (!('draftUpdatedAt' in data) || (data.draftUpdatedAt is string && data.draftUpdatedAt.size() <= 64)) &&
        (!('lastHeartbeat' in data) || (data.lastHeartbeat is string && data.lastHeartbeat.size() <= 64)) &&
        (!('joinedAt' in data) || (data.joinedAt is string && data.joinedAt.size() <= 64)) &&
        (!('sessionRunId' in data) || (data.sessionRunId is string && data.sessionRunId.size() <= 128)) &&
        (!('besExpiryIso' in data) || (data.besExpiryIso is string && data.besExpiryIso.size() <= 64)) &&
        (!('extendedExpiryIso' in data) || (data.extendedExpiryIso is string && data.extendedExpiryIso.size() <= 64)) &&
        (!('assignedFila' in data) || data.assignedFila in ['A', 'B']) &&
        (!('locked' in data) || data.locked is bool) &&
        (!('lockState' in data) || data.lockState in ['locked', 'unlocked']) &&
        (!('lockReason' in data) || (data.lockReason is string && data.lockReason.size() <= 400)) &&
        (!('lockedAt' in data) || (data.lockedAt is string && data.lockedAt.size() <= 64)) &&
        (!('answeredCount' in data) || (data.answeredCount is int && data.answeredCount >= 0 && data.answeredCount <= 500)) &&
        (!('totalQuestions' in data) || (data.totalQuestions is int && data.totalQuestions >= 1 && data.totalQuestions <= 500)) &&
        (!('mcDoneCount' in data) || (data.mcDoneCount is int && data.mcDoneCount >= 0 && data.mcDoneCount <= 500)) &&
        (!('openDoneCount' in data) || (data.openDoneCount is int && data.openDoneCount >= 0 && data.openDoneCount <= 500)) &&
        (!('currentProgressPercent' in data) || (data.currentProgressPercent is int && data.currentProgressPercent >= 0 && data.currentProgressPercent <= 100)) &&
        (!('tabSwitches' in data) || (data.tabSwitches is int && data.tabSwitches >= 0 && data.tabSwitches <= 10000)) &&
        (!('pasteAttempts' in data) || (data.pasteAttempts is int && data.pasteAttempts >= 0 && data.pasteAttempts <= 10000)) &&
        (!('remoteUnlockId' in data) || (data.remoteUnlockId is string && data.remoteUnlockId.size() <= 128)) &&
        (!('unlockedAt' in data) || (data.unlockedAt is string && data.unlockedAt.size() <= 64)) &&
        (!('unlockedBy' in data) || (data.unlockedBy is string && data.unlockedBy.size() <= 200)) &&
        (!('teacherNotice' in data) || (data.teacherNotice is string && data.teacherNotice.size() <= 300)) &&
        (!('teacherNoticeAt' in data) || (data.teacherNoticeAt is string && data.teacherNoticeAt.size() <= 64)) &&
        (!('teacherNoticeAckAt' in data) || (data.teacherNoticeAckAt is string && data.teacherNoticeAckAt.size() <= 64)) &&
        (!('classNoticeAckAt' in data) || (data.classNoticeAckAt is string && data.classNoticeAckAt.size() <= 64)) &&
        (!('status' in data) || data.status in ['waiting', 'in_progress', 'self_evaluating', 'submitted', 'offline']);
    }

    function isStudentLiveCreate(data, sessionId) {
      return isValidLiveStudentWrite(data) &&
        'studentEmail' in data && data.studentEmail is string && data.studentEmail.size() > 0 &&
        exists(/databases/$(database)/documents/active_sessions/$(sessionId)) &&
        !('remoteUnlockId' in data) &&
        !('unlockedAt' in data) &&
        !('unlockedBy' in data) &&
        !('teacherNotice' in data) &&
        !('teacherNoticeAt' in data) &&
        !('extendedExpiryIso' in data);
    }

    function isStudentLiveUpdate(sessionId) {
      return isValidLiveStudentWrite(incoming()) &&
        exists(/databases/$(database)/documents/active_sessions/$(sessionId)) &&
        !incoming().diff(existing()).affectedKeys().hasAny([
          'remoteUnlockId', 'unlockedAt', 'unlockedBy', 'teacherNotice', 'teacherNoticeAt', 'extendedExpiryIso'
        ]) &&
        (!('assignedFila' in existing()) || incoming().get('assignedFila', '') == existing().assignedFila) &&
        (!('joinedAt' in existing()) || existing().joinedAt.size() == 0 || incoming().get('joinedAt', '') == existing().joinedAt) &&
        incoming().get('tabSwitches', 0) >= existing().get('tabSwitches', 0) &&
        incoming().get('pasteAttempts', 0) >= existing().get('pasteAttempts', 0) &&
        (
          incoming().get('locked', false) == true ||
          existing().get('locked', false) == false
        );
    }

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Collection for authorized teachers (only primary super-admins can grant/revoke teacher roles)
    match /docenti/{docId} {
      allow get: if isSignedIn() && isValidDocId(docId);
      allow list: if isPrimaryTeacher() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow create, update: if isPrimaryTeacher() && isValidDocId(docId) && isValidDocente(incoming());
      allow delete: if isPrimaryTeacher() && isValidDocId(docId);
    }

    function isOwnerOrPrimaryTeacher(ownerEmail) {
      return isPrimaryTeacher() || (
        isTeacher() && (
          !(ownerEmail is string) ||
          ownerEmail.size() == 0 ||
          ownerEmail.lower() == request.auth.token.email.lower()
        )
      );
    }

    // Library of teacher-saved exams, reusable across classes/sessions
    match /exam_library/{docId} {
      allow get: if isTeacher() && isValidId(docId);
      allow list: if isTeacher();
      allow create: if isTeacher() && isValidId(docId) && isValidExamLibraryItem(incoming());
      allow update: if isTeacher() && isValidId(docId) && isValidExamLibraryItem(incoming()) && isOwnerOrPrimaryTeacher(existing().get('teacherEmail', ''));
      allow delete: if isTeacher() && isValidId(docId) && isOwnerOrPrimaryTeacher(existing().get('teacherEmail', ''));
    }

    // Cross-teacher exam sharing templates via short code
    match /shared_exams/{shareCode} {
      allow get: if isTeacher() && isValidId(shareCode);
      allow list: if isTeacher() && (isPrimaryTeacher() || resource.data.teacherEmail == request.auth.token.email);
      allow create: if isTeacher() && isValidId(shareCode) && isValidSharedExam(incoming());
      allow update: if isTeacher() && isValidId(shareCode) && isValidSharedExam(incoming()) && (isPrimaryTeacher() || existing().teacherEmail == request.auth.token.email);
      allow delete: if isValidId(shareCode) && (isPrimaryTeacher() || (isTeacher() && existing().teacherEmail == request.auth.token.email));
    }

    // Collection for exam submissions and evaluations
    match /valutazioni/{valId} {
      allow get: if isValidId(valId) && (
        isTeacher() ||
        !isSignedIn() ||
        (resource.data.Email is string && resource.data.Email.lower() == request.auth.token.email.lower())
      );
      allow list: if isTeacher() ||
        (isSignedIn() && resource.data.Email == request.auth.token.email) ||
        (!isSignedIn() && resource.data.Email is string && resource.data.Email.size() > 0);
      allow create: if isValidId(valId) &&
        isValidSubmissionCreate(incoming()) &&
        (!isSignedIn() || isTeacher() || incoming().Email.lower() == request.auth.token.email.lower());
      allow update: if isValidId(valId) && (
        (isTeacher() && isValidSubmissionPayload(incoming()) && isOwnerOrPrimaryTeacher(existing().get('Docente_Email', ''))) ||
        (isValidSubmissionPayload(incoming()) && isStudentRecoveryPlanUpdate())
      );
      allow delete: if isTeacher() && isValidId(valId) && isOwnerOrPrimaryTeacher(existing().get('Docente_Email', ''));
    }

    // Active exam sessions and live classroom progress
    match /active_sessions/{sessionId} {
      allow get: if isValidId(sessionId);
      allow list: if isTeacher();
      allow create: if isTeacher() && isValidId(sessionId) && isValidActiveSession(incoming());
      allow update: if isTeacher() && isValidId(sessionId) && isValidActiveSession(incoming()) && isOwnerOrPrimaryTeacher(existing().get('teacherEmail', ''));
      allow delete: if isTeacher() && isValidId(sessionId) && isOwnerOrPrimaryTeacher(existing().get('teacherEmail', ''));

      match /live_students/{studentId} {
        allow get: if isValidId(sessionId) && isValidId(studentId);
        allow list: if isTeacher();
        allow create: if isValidId(sessionId) && isValidId(studentId) && (
          (isTeacher() && isValidLiveStudentWrite(incoming())) ||
          isStudentLiveCreate(incoming(), sessionId)
        );
        allow update: if isValidId(sessionId) && isValidId(studentId) && (
          (isTeacher() && isValidLiveStudentWrite(incoming())) ||
          isStudentLiveUpdate(sessionId)
        );
        allow delete: if isTeacher() && isValidId(sessionId) && isValidId(studentId) && (
          isPrimaryTeacher() ||
          !exists(/databases/$(database)/documents/active_sessions/$(sessionId)) ||
          get(/databases/$(database)/documents/active_sessions/$(sessionId)).data.teacherEmail.lower() == request.auth.token.email.lower()
        );
      }
    }
  }
}
